# ==============================================================================
# Web Monitor - Weekly Report Email Configuration (.env.example)
# Salin file ini menjadi '.env' dan isi dengan konfigurasi SMTP Anda yang sebenarnya.
# JANGAN pernah meng-commit file '.env' ke repository git publik.
# ==============================================================================

# Alamat email penerima laporan mingguan
REPORT_EMAIL_TO=your-email@example.com

# Konfigurasi SMTP Server
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
SMTP_FROM="Web Monitor <your-email@example.com>"

# Port server backend (default: 3001)
PORT=3001

# Timezone Scheduler (default: Asia/Makassar)
REPORT_TIMEZONE=Asia/Makassar
