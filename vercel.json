{
  "version": 2,
  "rewrites": [
    { "source": "/api/maintenance/:match*", "destination": "/api/features.js" },
    { "source": "/api/maintenance", "destination": "/api/features.js" },
    { "source": "/api/features/:match*", "destination": "/api/features.js" },
